{
  "name": "omi-squad",
  "version": "0.0.0",
  "private": true,
  "description": "Project-local framework that turns a Claude Code session into a Coordinator for a squad of Claude Code/Codex agents working on GitHub Issues and Projects.",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write . \"!docs/**/*.md\"",
    "format:check": "prettier --check . \"!docs/**/*.md\"",
    "check:architecture": "depcruise src --config .dependency-cruiser.cjs && node tools/check-structure.ts",
    "check:backlog": "node tools/github-bootstrap/main.ts validate",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:live": "vitest run tests/live",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:architecture && npm run check:backlog && npm run test:unit && npm run test:integration"
  },
  "prettier": {
    "printWidth": 100,
    "endOfLine": "lf"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
