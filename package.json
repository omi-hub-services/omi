{
  "name": "omi-squad",
  "version": "0.1.0",
  "private": true,
  "description": "Project-local framework that turns a Claude Code session into a Coordinator for a squad of Claude Code/Codex agents working on GitHub Issues and Projects.",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write . \"!docs/**/*.md\" \"!docs/design/**\" \"!schemas/**\"",
    "format:check": "prettier --check . \"!docs/**/*.md\" \"!docs/design/**\" \"!schemas/**\"",
    "schemas:generate": "node --import ./tools/register-ts-imports.ts tools/generate-schemas.ts",
    "schemas:check": "node --import ./tools/register-ts-imports.ts tools/generate-schemas.ts --check",
    "check:architecture": "depcruise src --config .dependency-cruiser.cjs && node tools/check-structure.ts",
    "check:backlog": "node tools/github-bootstrap/main.ts validate",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "vitest run tests/e2e",
    "test:stress": "node tools/test-stress.ts",
    "test:live": "vitest run tests/live",
    "check": "npm run check:release && npm run typecheck && npm run build && npm run lint && npm run format:check && npm run check:architecture && npm run check:backlog && npm run schemas:check && npm run prompts:check && npm run check:coordinator-source && npm run test:unit && npm run test:integration && npm run test:contract && npm run test:e2e && npm run pack:check",
    "pack:check": "node tools/check-package.ts",
    "prompts:generate": "node tools/generate-worker-prompts.ts",
    "prompts:check": "node tools/generate-worker-prompts.ts --check",
    "check:coordinator-source": "node tools/coordinator/source-parity.ts",
    "check:release": "node tools/check-release.ts"
  },
  "prettier": {
    "printWidth": 100,
    "endOfLine": "lf"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "zod": "4.6.7",
    "yaml": "2.9.1"
  },
  "files": [
    "dist/",
    "templates/",
    "schemas/",
    "migrations/"
  ],
  "bin": {
    "omi-squad": "dist/bootstrap/cli.js"
  }
}
