{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "templates/bridges/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "node_modules", "tests/fixtures"]
}
