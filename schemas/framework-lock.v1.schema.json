  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?$"
    },
    "artifactHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "distribution": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "projectDir": {
      "type": "string",
      "maxLength": 4096,
      "format": "starts_with",
      "pattern": "^\\/.*"
    },
    "base": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:(workflows|roles|rules|skills|config|provenance)\\/[A-Za-z0-9._/-]+|bridge\\/(?:CLAUDE\\.md|AGENTS\\.md|skill\\/(?:SKILL\\.md|bridge\\.ts|bridge\\.config\\.json)))$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1048576
      }
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "artifactHash",
    "distribution",
    "projectDir",
    "base"
  ],
  "additionalProperties": false
}
