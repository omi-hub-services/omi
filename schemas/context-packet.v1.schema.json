{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "stepId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "taskSnapshot": {
      "type": "object",
      "properties": {
        "issueNumber": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "body": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "issueNumber",
        "title",
        "body"
      ],
      "additionalProperties": false
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "businessBaselineHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "capabilityProfile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "min_effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "required": [
        "id",
        "min_effort"
      ],
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^\\/(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[^\\\\]*$"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "inputArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[^\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "skillsManifest": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "rulesManifest": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "previousFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major",
              "blocker"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "id",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "checkpointRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[^\\\\]+$"
    },
    "expectedOutputSchema": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "allowedScope": {
      "type": "object",
      "properties": {
        "paths": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[^\\\\]+$"
          }
        }
      },
      "required": [
        "paths"
      ],
      "additionalProperties": false
    },
    "approvalRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "stepId",
    "attemptId",
    "taskSnapshot",
    "acceptanceCriteria",
    "businessBaselineHash",
    "role",
    "capabilityProfile",
    "workspace",
    "inputArtifacts",
    "skillsManifest",
    "rulesManifest",
    "previousFindings",
    "expectedOutputSchema",
    "allowedScope",
    "approvalRefs"
  ],
  "additionalProperties": false,
  "title": "omi-squad context packet v1"
}
